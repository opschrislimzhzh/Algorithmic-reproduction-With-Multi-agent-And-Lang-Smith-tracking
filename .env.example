# =========================
# Paper2Code LLM
# =========================
# OpenAI-compatible API. Defaults below are for Alibaba DashScope/Qwen.
P2C_API_KEY=replace_me
P2C_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
P2C_MODEL=qwen-plus

# Optional aliases. P2C_API_KEY has highest priority.
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=

# =========================
# LangSmith
# =========================
P2C_LANGSMITH_ENABLED=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=Paper2Code-repro

# Use the endpoint that matches your LangSmith account/region.
# EU (the setup used in our reproduction):
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# US alternative:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
